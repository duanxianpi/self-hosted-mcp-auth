{
  "name": "self-hosted-mcp-auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2022 --external:cloudflare:* --outfile=dist/worker.js",
    "dev": "wrangler dev",
    "deploy": "node scripts/deploy.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/server": "2.4.0",
    "@simplewebauthn/server": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261102.1",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "wrangler": "4.156.1"
  }
}
